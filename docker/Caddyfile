{
	admin off
	# TLS is the reverse proxy's job; this listens on plain HTTP.
	auto_https off
	frankenphp
}

:8080 {
	root * /app/public

	@dotfiles {
		path_regexp dot ^/\.
		not path /.well-known/*
	}
	respond @dotfiles 404

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	encode zstd gzip

	php_server
}
