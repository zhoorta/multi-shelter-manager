APP_NAME="Focinhos demo"
APP_URL=https://demo.focinhos.pt
# docker run --rm <image> php artisan key:generate --show   (its own key, never production's)
APP_KEY=

# Docker bridge range: nginx reaches the container through the gateway. The per-IP limit on demo
# starts relies on the real client IP arriving via X-Forwarded-For from nginx.
TRUSTED_PROXIES=172.16.0.0/12
SESSION_SECURE_COOKIE=true

# How long a sandbox lives, how many can exist at once and who to contact (shown in the banner).
DEMO_TTL_MINUTES=120
DEMO_MAX_SANDBOXES=30
DEMO_CONTACT=
